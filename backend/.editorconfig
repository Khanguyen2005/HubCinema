# EditorConfig  —  https://editorconfig.org
# Shared code style for the HubCinema backend. The IDE (VS / VS Code / Rider)
# reads this automatically; with EnforceCodeStyleInBuild=true, violations also
# show up as warnings during `dotnet build`.
# `root = true` stops editors from looking in parent folders for more rules.
root = true

############################
# All files
############################
[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props,targets,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

############################
# C# files
############################
[*.cs]
indent_size = 4

# --- using directives ---
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
# Prefer file-scoped namespaces (modern C#)
csharp_style_namespace_declarations = file_scoped:warning

# --- 'this.' qualification: don't ---
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# --- language keywords over framework types (int, not Int32) ---
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning

# --- var usage ---
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# --- expression-bodied members ---
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion

# --- modern patterns ---
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion
dotnet_style_null_propagation = true:warning
dotnet_style_coalesce_expression = true:warning
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion

# --- braces & newlines ---
csharp_prefer_braces = true:warning
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# --- readonly / accessibility ---
dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

############################
# Naming rules (C#)
############################
# Interfaces must be IPascalCase
dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbol
dotnet_naming_rule.interfaces_start_with_i.style = i_pascal_style
dotnet_naming_symbols.interface_symbol.applicable_kinds = interface
dotnet_naming_style.i_pascal_style.capitalization = pascal_case
dotnet_naming_style.i_pascal_style.required_prefix = I

# Types & public members: PascalCase
dotnet_naming_rule.types_pascal.severity = warning
dotnet_naming_rule.types_pascal.symbols = type_and_member_symbol
dotnet_naming_rule.types_pascal.style = pascal_style
dotnet_naming_symbols.type_and_member_symbol.applicable_kinds = class,struct,enum,property,method,event,delegate
dotnet_naming_symbols.type_and_member_symbol.applicable_accessibilities = public,internal,protected
dotnet_naming_style.pascal_style.capitalization = pascal_case

# Private fields: _camelCase
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_field_symbol
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_style
dotnet_naming_symbols.private_field_symbol.applicable_kinds = field
dotnet_naming_symbols.private_field_symbol.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_style.capitalization = camel_case
dotnet_naming_style.underscore_camel_style.required_prefix = _

# Constants: PascalCase
dotnet_naming_rule.constants_pascal.severity = warning
dotnet_naming_rule.constants_pascal.symbols = constant_symbol
dotnet_naming_rule.constants_pascal.style = pascal_style
dotnet_naming_symbols.constant_symbol.applicable_kinds = field
dotnet_naming_symbols.constant_symbol.required_modifiers = const
